<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/quizScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/kindle_sepia_bg">

    <LinearLayout
        android:id="@+id/quizRootContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Quiz Category Selector Tabs -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/quizCategoryTabs"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="#222C3A"
            app:tabIndicatorColor="@color/accent"
            app:tabIndicatorHeight="3dp"
            app:tabSelectedTextColor="#38BDF8"
            app:tabTextColor="#94A3B8"
            app:tabMode="fixed"
            app:tabGravity="fill" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCommunityQuizzes"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="🌐 Browse"
                android:textAllCaps="false"
                android:textSize="14sp"
                app:strokeColor="@color/accent"
                app:strokeWidth="1dp"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCreateQuiz"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="✍️ Create"
                android:textAllCaps="false"
                android:textSize="14sp"
                app:strokeColor="@color/accent"
                app:strokeWidth="1dp"
                app:cornerRadius="8dp" />

        </LinearLayout>

        <!-- Difficulty Selector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvDifficultyLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Difficulty:"
                android:textSize="14sp"
                android:textColor="#94A3B8"
                android:layout_marginEnd="8dp" />

            <RadioGroup
                android:id="@+id/difficultyRadioGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbEasy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Easy"
                    android:textSize="13sp"
                    android:textColor="#E2E8F0"
                    android:layout_marginEnd="8dp" />

                <RadioButton
                    android:id="@+id/rbMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Medium"
                    android:textSize="13sp"
                    android:textColor="#E2E8F0"
                    android:checked="true"
                    android:layout_marginEnd="8dp" />

                <RadioButton
                    android:id="@+id/rbHard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hard"
                    android:textSize="13sp"
                    android:textColor="#E2E8F0" />

            </RadioGroup>

        </LinearLayout>

        <!-- Quiz Progress Bar -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/quizProgressBar"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="12dp"
            android:progress="20"
            app:indicatorColor="@color/accent"
            app:trackColor="#20000000" />

        <TextView
            android:id="@+id/tvQuizProgressCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Question 1 of 5"
            android:textColor="@color/kindle_sepia_subtext"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />

        <!-- Empty State Container for Community Quiz Categories -->
        <LinearLayout
            android:id="@+id/emptyCategoryContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:background="@drawable/bg_callout_box"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvEmptyCategoryMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="No questions uploaded by this creator for this category"
                android:textColor="@color/kindle_sepia_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEmptyCategorySubtext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Switch to another category above to continue playing this quiz."
                android:textColor="@color/kindle_sepia_subtext"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Question Container Card -->
        <LinearLayout
            android:id="@+id/questionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="@drawable/bg_callout_box"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvQuestionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Question text goes here..."
                android:textColor="@color/kindle_sepia_text"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:lineSpacingMultiplier="1.3" />

            <!-- Options Radio Group / Choice List -->
            <RadioGroup
                android:id="@+id/optionsRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <RadioButton
                    android:id="@+id/rbOption0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="4dp"
                    android:background="@drawable/bg_code_box"
                    android:padding="12dp"
                    android:text="Option A"
                    android:textColor="@color/kindle_sepia_text"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/rbOption1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="4dp"
                    android:background="@drawable/bg_code_box"
                    android:padding="12dp"
                    android:text="Option B"
                    android:textColor="@color/kindle_sepia_text"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/rbOption2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="4dp"
                    android:background="@drawable/bg_code_box"
                    android:padding="12dp"
                    android:text="Option C"
                    android:textColor="@color/kindle_sepia_text"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/rbOption3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="4dp"
                    android:background="@drawable/bg_code_box"
                    android:padding="12dp"
                    android:text="Option D"
                    android:textColor="@color/kindle_sepia_text"
                    android:textSize="15sp" />
            </RadioGroup>

            <!-- Submit Answer Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitAnswer"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="Submit Answer"
                android:textAllCaps="false"
                android:textSize="15sp"
                app:backgroundTint="@color/accent"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <!-- Explanation Feedback Box (Hidden initially) -->
        <LinearLayout
            android:id="@+id/explanationContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="@drawable/bg_callout_box"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvFeedbackTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Correct! 🎉"
                android:textColor="#276749"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvExplanationText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Detailed explanation of why this answer is correct..."
                android:textColor="@color/kindle_sepia_text"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNextQuestion"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="Next Question ➔"
                android:textAllCaps="false"
                android:textSize="15sp"
                app:backgroundTint="#2B6CB0"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <!-- Final Score Summary View (Hidden initially) -->
        <LinearLayout
            android:id="@+id/scoreSummaryContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:background="@drawable/bg_callout_box"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvSummaryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏆 Quiz Completed!"
                android:textColor="@color/kindle_sepia_text"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="serif" />

            <TextView
                android:id="@+id/tvFinalScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="You scored 4 / 5 (80%)"
                android:textColor="@color/accent"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvScoreMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Great job! You have a strong grasp of these concepts."
                android:textColor="@color/kindle_sepia_subtext"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetryQuiz"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:text="Retake Quiz"
                android:textAllCaps="false"
                android:textSize="15sp"
                app:backgroundTint="@color/accent"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReviewMistakes"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="Review Mistakes"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:visibility="gone"
                app:backgroundTint="#C53030"
                app:cornerRadius="8dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>