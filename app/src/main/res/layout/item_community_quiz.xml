<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardCommunityQuiz"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_callout_box"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvQuizTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Quiz Title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/kindle_sepia_text" />

        <TextView
            android:id="@+id/tvQuizCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="JNI, Flutter"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_category_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:maxWidth="120dp"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvQuizAuthor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="by Author Name"
        android:textSize="13sp"
        android:textColor="@color/kindle_sepia_subtext"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/tvQuizDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Brief description of the quiz content goes here."
        android:textSize="14sp"
        android:textColor="@color/kindle_sepia_subtext"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/tvQuizMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="10 questions • ❤ 42 • ⬇ 128"
        android:textSize="12sp"
        android:textColor="@color/kindle_sepia_subtext"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuizLike"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Like"
            android:textSize="13sp"
            app:icon="@android:drawable/btn_star_big_off"
            app:iconSize="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuizTake"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Take Quiz"
            android:textSize="13sp"
            app:backgroundTint="@color/accent"
            app:cornerRadius="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuizEdit"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit"
            android:textSize="13sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuizDelete"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Delete"
            android:textColor="#C53030"
            android:textSize="13sp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
