<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pageScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:id="@+id/pageContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="36dp">

        <!-- Category Badge / Chip -->
        <TextView
            android:id="@+id/tvCategoryBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_category_badge"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="JNI DOCUMENTATION"
            android:textColor="#3182CE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <!-- Chapter / Section Title -->
        <TextView
            android:id="@+id/tvPageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Chapter 1: Overview of JNI"
            android:textColor="@color/kindle_sepia_text"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:lineSpacingExtra="4dp" />

        <!-- Chapter Subtitle / Reading time -->
        <TextView
            android:id="@+id/tvPageSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Java Native Interface Fundamentals • 3 min read"
            android:textColor="@color/kindle_sepia_subtext"
            android:textSize="13sp"
            android:fontFamily="sans-serif" />

        <!-- Divider Line -->
        <View
            android:id="@+id/pageDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="@color/kindle_sepia_divider" />

        <!-- Main Formatted Body Text -->
        <TextView
            android:id="@+id/tvPageContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Body text content goes here..."
            android:textColor="@color/kindle_sepia_text"
            android:textSize="16sp"
            android:lineSpacingMultiplier="1.45"
            android:fontFamily="serif"
            android:textIsSelectable="true" />

        <!-- Code Snippet Box (Visible when code examples are present) -->
        <LinearLayout
            android:id="@+id/codeBoxContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:background="@drawable/bg_code_box"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvCodeBoxTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CODE EXAMPLE"
                android:textColor="#3182CE"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvCodeBoxContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="// Code snippet"
                android:textColor="@color/kindle_sepia_text"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:lineSpacingMultiplier="1.2"
                android:textIsSelectable="true" />
        </LinearLayout>

        <!-- Chapter Summary / Key Principle Callout -->
        <LinearLayout
            android:id="@+id/calloutBoxContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:background="@drawable/bg_callout_box"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvCalloutTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💡 KEY TAKEAWAY / BEST PRACTICE"
                android:textColor="#2B6CB0"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCalloutContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Always release JNI local references when creating many objects inside loops."
                android:textColor="@color/kindle_sepia_text"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingMultiplier="1.3" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>